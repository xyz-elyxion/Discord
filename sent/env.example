# Limey Guard configuration template — placeholders only.
# Copy to a file named e.g. `sentinel.env` and replace every <> value.
# Never commit the filled copy.

# --- required ---------------------------------------------------------------
# Token signing secret (>= 32 bytes). Generate: openssl rand -hex 32
SENTINEL_TOKEN_SECRET=<openssl rand -hex 32>

# --- database ----------------------------------------------------------------
SENTINEL_PG_DSN=postgres://sentinel:<pg-password>@localhost:5432/sentinel?sslmode=prefer
SENTINEL_PG_PASSWORD=<pg-password>

# --- optional ----------------------------------------------------------------
# Redis for shared replay protection & rate limiting across instances.
SENTINEL_REDIS_ADDR=localhost:6379
# When unset, falls back to in-memory (single instance only).
SENTINEL_REDIS_URI=redis://localhost:6379/0

# Client-ID pepper (>= 16 chars). If unset, derived per process.
SENTINEL_CLIENT_PEPPER=<random 16+ chars>

# Server bind address.
SENTINEL_ADDR=0.0.0.0:8080

# --- first-run administrator (bootstrap) --------------------------------------
# Used only by: server -bootstrap (see cmd/server). Unset afterwards in production.
SENTINEL_ADMIN_USER=<admin-username>
SENTINEL_ADMIN_PASSWORD=<at least 12 chars>
