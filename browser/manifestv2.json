{
    "manifest_version": 2,
    "minimum_chrome_version": "91",

    "name": "Limey V1 Web",
    "description": "The cutest Discord mod now in your browser",
    "author": "Limey",
    "homepage_url": "https://limey-discord.onrender.com",
    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*",
        "https://limey-discord.onrender.com/*",
        "http://localhost/*"
    ],

    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["content.js"],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["dist/browser.js"],
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "run_at": "document_end",
            "matches": ["https://limey-discord.onrender.com/*", "http://localhost/*"],
            "js": ["content.js"]
        }
    ],

    "background": {
        "scripts": ["background.js"]
    },

    "web_accessible_resources": ["dist/browser.js", "dist/browser.css"],

    "browser_specific_settings": {
        "gecko": {
            "id": "limeyV1-firefox@limey-discord.onrender.com",
            "strict_min_version": "128.0"
        }
    }
}
